# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=justcall

# Server
PORT=3001
BASE_URL=http://localhost:3001
NODE_ENV=development
DATA_DIR=./data

# WhatsApp outbound send pacing (ms between messages). Raise to avoid bans
# when bulk/broadcast messaging. Used by notification-service + broadcast.
WA_SEND_INTERVAL_MS=1000

# Max recipients per single broadcast request (load/abuse protection)
MAX_BROADCAST=500

# JWT - Generate strong random strings, NEVER use these placeholders as actual secrets
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
REFRESH_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# DB connection pool
DB_POOL_SIZE=10
DB_ACQUIRE_TIMEOUT=10000

# Gemini AI key (optional - for AI features)
GEMINI_API_KEY=

# Vite API URL (leave empty to use Vite proxy in dev)
VITE_API_URL=

# Firebase (optional - for legacy realtime features)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
