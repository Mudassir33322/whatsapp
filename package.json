{
  "name": "autozap-enterprise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "build:frontend": "vite build",
    "build:backend": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "start:dev": "tsx server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx seed.ts",
    "deploy:hostinger": "npm run build && node dist/server.js",
    "pm2:start": "pm2 start dist/server.js --name autozap --time",
    "docker:build": "docker build -t autozap:latest .",
    "postinstall": "node -e \"try { require('better-sqlite3'); } catch(e) { console.log('better-sqlite3 optional, using MySQL'); }\""
  },
