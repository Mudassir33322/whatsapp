# ============================================
# AutoZap Enterprise - Production Configuration
# ============================================
# ⚠️ IMPORTANT: Fill all values before deploying!
# NEVER commit this file to git with real credentials.

# Database (MySQL recommended for production)
DB_HOST=your-mysql-host
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=autozap_platform
DB_PORT=3306
DB_SSL=true

# For SQLite (single-server low-traffic only):
# USE_SQLITE=true
# DB_PATH=/data/autozap.sqlite

# Server
PORT=3001
BASE_URL=https://yourdomain.com
NODE_ENV=production
DATA_DIR=/data

# ⚠️ CRITICAL: Generate unique secrets!
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX_STRING

# CORS - comma-separated allowed origins
CORS_ORIGIN=https://yourdomain.com

# DB connection pool
DB_POOL_SIZE=25
DB_ACQUIRE_TIMEOUT=10000

# Gemini AI key (optional)
GEMINI_API_KEY=

# Vite API URL (leave empty to use same domain)
VITE_API_URL=
