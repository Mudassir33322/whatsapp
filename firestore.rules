rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && incoming().userId == userId
        && incoming().keys().hasAll(['userId', 'email'])
        && incoming().keys().size() <= 5;
      allow update: if isOwner(userId) 
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);
    }

    // --- WhatsApp Sessions ---
    match /sessions/{sessionId} {
      function isValidSession(data) {
        return data.sessionId is string 
          && data.userId is string 
          && data.status in ['DISCONNECTED', 'CONNECTING', 'QR_READY', 'CONNECTED', 'ERROR']
          && (!('battery' in data) || data.battery is number)
          && (!('lastQr' in data) || (data.lastQr is string && data.lastQr.size() < 10000));
      }

      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(sessionId)
        && incoming().userId == request.auth.uid
        && isValidSession(incoming());
        
      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid
        && isValidSession(incoming())
        && (
          // System updates (status/qr)
          incoming().diff(existing()).affectedKeys().hasAny(['status', 'lastQr', 'updatedAt', 'battery'])
        );
      
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // --- Bookings ---
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidId(bookingId)
        && incoming().userId == userId
        && incoming().customerPhone is string
        && incoming().appointmentTime is string;
      allow update: if isOwner(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reminderSent']);
      allow delete: if isOwner(userId);
    }

    // --- CRM ---
    match /users/{userId}/customers/{phone} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && incoming().userId == userId
        && (phone.size() >= 5);
      allow delete: if isOwner(userId);
    }

    // --- Automations ---
    match /users/{userId}/automations/{ruleId} {
      allow read, write: if isOwner(userId);
    }

    // --- Logs ---
    match /users/{userId}/logs/{logId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().keys().hasAll(['sender', 'incomingText', 'replyText', 'type', 'timestamp']);
    }
  }
}
