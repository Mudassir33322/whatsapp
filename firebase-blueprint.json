{
  "entities": {
    "user": {
      "title": "User",
      "description": "App user profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["userId", "email"]
    },
    "whatsappSession": {
      "title": "WhatsApp Session",
      "description": "WhatsApp web instance status and metadata.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["DISCONNECTED", "CONNECTING", "QR_READY", "CONNECTED", "ERROR"] },
        "battery": { "type": "number" },
        "plugged": { "type": "boolean" },
        "platform": { "type": "string" },
        "lastQr": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "userId", "status"]
    },
    "booking": {
      "title": "Booking",
      "description": "Appointment/Booking entry.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "serviceType": { "type": "string" },
        "appointmentTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "reminderSent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "userId", "customerPhone", "appointmentTime"]
    },
    "crmEntry": {
      "title": "CRM Customer",
      "description": "Customer contact and lead info.",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "tags": { "type": "array" },
        "notes": { "type": "string" },
        "lastInteraction": { "type": "string", "format": "date-time" }
      },
      "required": ["phone", "userId"]
    },
    "automation": {
      "title": "Automation Rule",
      "description": "Workflow/Reply automation rule.",
      "type": "object",
      "properties": {
        "ruleId": { "type": "string" },
        "userId": { "type": "string" },
        "trigger": { "type": "string" },
        "action": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "interactionLog": {
      "title": "Interaction Log",
      "description": "Log of AI interactions and messages.",
      "type": "object",
      "properties": {
        "sender": { "type": "string" },
        "incomingText": { "type": "string" },
        "replyText": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "user", "description": "User profiles." },
    "/sessions/{sessionId}": { "schema": "whatsappSession", "description": "Global session management." },
    "/users/{userId}/bookings/{bookingId}": { "schema": "booking", "description": "User specific bookings." },
    "/users/{userId}/customers/{phone}": { "schema": "crmEntry", "description": "User CRM database." },
    "/users/{userId}/automations/{ruleId}": { "schema": "automation", "description": "User custom workflows." },
    "/users/{userId}/logs/{logId}": { "schema": "interactionLog", "description": "AI reply logs." }
  }
}
